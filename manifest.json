{
  "manifest_version": 3,
  "name": "OnshapePlus",
  "version": "1.0.0",

  "browser_specific_settings": {
    "gecko": {
      "id": "@fakeID",
      "data_collection_permissions": {
        "required": ["none"]
      }
    }
  },
  "content_scripts": [
    {
      "matches": ["*://*.onshape.com/*"],
      "js": ["/onshape_script.js"]
    }
  ],

  "icons": {
    "16": "/icon-16.png",
    "32": "/icon-32.png",
    "48": "/icon-48.png",
    "128": "/icon-128.png"
  },
  "action": {
    "default_icon": {
      "16": "/icon-16.png",
      "32": "/icon-32.png",
      "48": "/icon-48.png",
      "128": "/icon-128.png"
    },
    "default_title": "OnshapePlus",
    "default_popup": "/popup.html"
  },

  "permissions": ["storage"],
  "background": {
    "scripts": ["background_script.js"],
    "service_worker": "background_script.js"
  },

  "homepage_url": "https://github.com/dhmango/" //what?
}
